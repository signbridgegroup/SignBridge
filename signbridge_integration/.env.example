# Copy this file to backend/.env and fill in real values locally.
# Never commit the real .env or key.env file.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Root of the existing SignBridge research project (checkpoints, datasets,
# MediaPipe model, RAG content). Override this on any machine other than
# the original Windows development machine.
SIGNBRIDGE_PROJECT_ROOT=C:\SignBridge_Project

# Individual resource overrides. When left empty, the backend derives a
# default path from SIGNBRIDGE_PROJECT_ROOT.
SIGNBRIDGE_CHECKPOINT=
SIGNBRIDGE_MEDIAPIPE_MODEL=
SIGNBRIDGE_KARSL_LABELS=

# Where generated avatar motion JSON files are stored and served from.
# Must NOT be inside frontend/src or frontend/public.
SIGNBRIDGE_MOTION_LIBRARY=

# Comma-separated list of allowed CORS origins for the frontend dev server.
SIGNBRIDGE_FRONTEND_ORIGINS=http://localhost:5173
